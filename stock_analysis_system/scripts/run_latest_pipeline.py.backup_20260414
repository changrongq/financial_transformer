from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "src"
if str(SRC) not in sys.path:
    sys.path.insert(0, str(SRC))

from hierarchical_system.config import load_config
from hierarchical_system.inference import ProductionInferenceEngine
from hierarchical_system.market_cap import fetch_and_store_market_caps
from hierarchical_system.trade_data import latest_trade_date, update_latest_trade_data


if __name__ == "__main__":
    config = load_config(ROOT / "config.yaml")
    trade_df = update_latest_trade_data(config)
    fetch_and_store_market_caps(config, refresh_existing=True)
    result = ProductionInferenceEngine(ROOT / "config.yaml").predict_latest(top_n=50)
    trade_max_date = latest_trade_date(config.databases.trade_db)
    prediction_max_date = str(result["date"].max()) if not result.empty else None
    if trade_max_date and prediction_max_date != trade_max_date:
        raise RuntimeError(
            f"最新预测日期落后于交易库: trade_db={trade_max_date}, latest_picks={prediction_max_date}. "
            "请检查最新行情是否完整写入以及当日样本是否满足特征窗口要求。"
        )
    print(
        {
            "trade_rows": len(trade_df),
            "trade_date": trade_df["日期"].max() if not trade_df.empty else None,
            "prediction_count": len(result),
            "prediction_date": prediction_max_date,
            "top_stock": result.iloc[0]["stock_code"] if not result.empty else None,
            "output_file": str(config.results_dir / "latest_picks.csv"),
        }
    )